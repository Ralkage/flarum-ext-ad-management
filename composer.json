{
    "name": "ralkage/flarum-ext-ad-management",
    "description": "Comprehensive ad management system for Flarum with zones, analytics, and ad owner self-service.",
    "keywords": ["flarum", "extension", "ads", "advertising", "ad management", "adsense"],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0.0-beta.7"
    },
    "authors": [
        {
            "name": "Ralkage",
            "email": "me@ralkage.com",
            "homepage": "https://ralkage.com"
        }
    ],
    "homepage": "https://ralkage.com",
    "autoload": {
        "psr-4": {
            "Ralkage\\AdManagement\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "flarum-extension": {
            "title": "Ad Management",
            "category": "feature",
            "icon": {
                "name": "fas fa-ad",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        }
    }
}
